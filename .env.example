# ai-metrics-api runtime
INFERENCE_LOG_PATH=/app/data/day02/inference.log
LOG_BACKEND=file
SQLITE_LOG_PATH=/app/data/day02/inference.sqlite3
MODEL_BACKEND=mock
MOCK_MODEL_SERVER_URL=http://mock-model-server:8001/generate
VLLM_BASE_URL=http://host.docker.internal:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
MODEL_SERVER_TIMEOUT_SEC=30

# admission control
MAX_IN_FLIGHT_REQUESTS=8
ADMISSION_MODE=reject
MAX_QUEUE_SIZE=32
QUEUE_TIMEOUT_MS=500

# inference endpoint authentication
REQUIRE_API_KEY=false
API_KEY=

# mock backend behavior
MOCK_MODEL_DELAY_SCALE=0

# local Grafana login
GRAFANA_ADMIN_PASSWORD=admin
